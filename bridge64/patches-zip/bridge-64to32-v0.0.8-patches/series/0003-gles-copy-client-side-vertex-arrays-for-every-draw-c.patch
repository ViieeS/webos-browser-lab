@@ -2585,6 +2648,20 @@ GL_APICALL void GL_APIENTRY glDrawElements(GLenum mode, GLsizei count,
   GLContextState *ctx = &g_stub_ctx[g_stub_current_ctx];
   VAOState *vao = &ctx->vaos[ctx->current_vao];
 
+  /* indices in an element buffer but vertices in client memory: the vertex
