+/* Highest index (plus base vertex 0) in [offset, offset + count) of the bound
+ * element buffer, read through a temporary read mapping; -1 if unknown. */
+void h_bridgeIndexRange(BridgeCtrl *C, uint8_t *D)
+{
   (void)D;
+  AR(r);
+  GLenum type = ar_u32(&r);
+  uint64_t offset = ar_u64(&r);
+  GLsizei count = ar_i32(&r);
+  bool restart = ar_u32(&r) != 0;
+
+  size_t isz = type == GL_UNSIGNED_BYTE    ? 1
+               : type == GL_UNSIGNED_SHORT ? 2
+               : type == GL_UNSIGNED_INT   ? 4
+                                           : 0;
+  int64_t max_index = -1;
+
+  if (isz && count > 0)
+  {
+    const uint8_t *p = glMapBufferRange(GL_ELEMENT_ARRAY_BUFFER,
+                                        (GLintptr)offset,
+                                        (GLsizeiptr)(count * isz),
+                                        GL_MAP_READ_BIT);
+    if (p)
+    {
+      uint32_t restart_index = isz == 1 ? 0xFFu : isz == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+      for (GLsizei i = 0; i < count; i++)
+      {
+        uint32_t v = isz == 1 ? p[i]
+                     : isz == 2 ? ((const uint16_t *)p)[i]
+                                : ((const uint32_t *)p)[i];
+        if (restart && v == restart_index)
+          continue;
+        if ((int64_t)v > max_index)
+          max_index = v;
+      }
+      glUnmapBuffer(GL_ELEMENT_ARRAY_BUFFER);
+    }
+    else
+      log_error("h_bridgeIndexRange: cannot map the element buffer (0x%x)",
+                glGetError());
+  }
+
+  C->result = (uint64_t)max_index;
 }
 
