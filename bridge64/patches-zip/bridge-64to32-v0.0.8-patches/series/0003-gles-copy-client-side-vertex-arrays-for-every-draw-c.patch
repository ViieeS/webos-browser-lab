+/* Vertex range of an indexed draw for copying client-side arrays: from the
+ * client index array, or from the bound element buffer. -1: unknown. */
+static GLintptr indexed_vertex_end(const void *indices, bool client_indices,
+                                   GLsizei count, GLenum type)
+{
+  if (!stub_has_client_vertex_arrays())
+    return 0;
+  if (client_indices)
+  {
+    GLContextState *ctx = &g_stub_ctx[g_stub_current_ctx];
+    GLintptr lo = 0, hi = -1;
+    if (!mapped_index_bounds((const uint8_t *)indices, count, type, 0,
+                             ctx->primitive_restart, &lo, &hi))
+      return 0;
+    return hi + 1;
+  }
+  return stub_element_buffer_vertex_end(type, (uintptr_t)indices, count, 0);
+}
