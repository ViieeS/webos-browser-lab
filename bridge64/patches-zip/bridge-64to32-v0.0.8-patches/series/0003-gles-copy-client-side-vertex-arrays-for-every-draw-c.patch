diff --git a/proxy/protocol/gles2.c b/proxy/protocol/gles2.c
index e9986c7..4ae96bc 100644
--- a/proxy/protocol/gles2.c
+++ b/proxy/protocol/gles2.c
@@ -1650,6 +1650,45 @@ H_VAFV(4, glVertexAttrib4fv)
 
 /* ── Draw ────────────────────────────────────────────────────────────────── */
 
+/* Reads the client-side array list a draw call carries ("count, (index,
+ * offset) * count", see stub_write_client_arrays) and points those attributes
+ * of the current VAO at the copies in the data arena. Returns true if
+ * GL_ARRAY_BUFFER was unbound for that and must be restored to
+ * *prev_array_buffer after the draw. */
+bool proxy_apply_client_arrays(ArgReader *r, GLint *prev_array_buffer)
+{
+  uint32_t n = ar_u32(r);
+  if (n == 0)
+    return false;
+
+  GLContextState *ctx = &g_proxy_ctx[g_current_ctx];
+  VAOState *vao = &ctx->vaos[ctx->current_vao];
+
+  glGetIntegerv(GL_ARRAY_BUFFER_BINDING, prev_array_buffer);
+  glBindBuffer(GL_ARRAY_BUFFER, 0);
+
+  for (uint32_t i = 0; i < n; i++)
+  {
+    GLuint index = ar_u32(r);
+    uint32_t off = ar_u32(r);
+    if (index >= MAX_VERTEX_ATTRIBS)
+      continue;
+
+    AttribState *a = &vao->attribs[index];
+    a->pointer = (uintptr_t)dp(off);
+    g_attrib_proxy_state[index].pointer = a->pointer;
+
+    if (a->integer)
+      glVertexAttribIPointer(index, a->size, a->type, a->stride,
+                             (const void *)a->pointer);
+    else
+      glVertexAttribPointer(index, a->size, a->type, a->normalized, a->stride,
+                            (const void *)a->pointer);
+  }
+
+  return true;
+}
+
 void h_glDrawArrays(BridgeCtrl *C, uint8_t *D)
 {
   AR(r);
@@ -1882,7 +1921,31 @@ void h_glDrawElements(BridgeCtrl *C, uint8_t *D)
 #ifdef DEBUG_VERBOSE
     log_console("h_glDrawElements: ebo mode");
 #endif
+    /* indices in the element buffer, but vertex data may still be in
+     * client-side arrays (copied by the stub, pointers patched above) */
+    GLint prev_ab = 0;
+    bool restore_ab = false;
+    for (int i = 0; i < MAX_VERTEX_ATTRIBS && attrib_count; i++)
+    {
+      AttribState *a = &vao->attribs[i];
+      if (!a->enabled || a->vbo != 0)
+        continue;
+      if (!restore_ab)
+      {
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prev_ab);
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+        restore_ab = true;
+      }
+      if (a->integer)
+        glVertexAttribIPointer(i, a->size, a->type, a->stride,
+                               (const void *)a->pointer);
+      else
+        glVertexAttribPointer(i, a->size, a->type, a->normalized, a->stride,
+                              (const void *)a->pointer);
+    }
     glDrawElements(mode, count, type, (const void *)indices);
+    if (restore_ab)
+      glBindBuffer(GL_ARRAY_BUFFER, prev_ab);
     return;
   }
 
