+/* ── Client-side vertex arrays ───────────────────────────────────────────
+ *
+ * An attribute enabled with no buffer bound points into the 64-bit client's
+ * memory; the proxy cannot read it. Every draw call therefore copies the data
+ * of such attributes into the data arena and sends their offsets, and the
+ * proxy re-points the attributes at the copies before drawing. Without this,
+ * the proxy hands the driver a 64-bit pointer truncated to 32 bits and the
+ * driver reads unrelated proxy memory or crashes (Skia does this on Mali: it
+ * prefers client-side arrays for dynamic vertex and index data there).
+ */
+
+/* true if the current VAO has an enabled client-side per-vertex attribute */
+bool stub_has_client_vertex_arrays(void)
+{
+  GLContextState *ctx = &g_stub_ctx[g_stub_current_ctx];
+  VAOState *vao = &ctx->vaos[ctx->current_vao];
+  for (int i = 0; i < MAX_VERTEX_ATTRIBS; i++)
+  {
+    AttribState *a = &vao->attribs[i];
+    if (a->enabled && a->vbo == 0 && a->pointer && a->divisor == 0)
+      return true;
+  }
+  return false;
+}
+
+/* Copies the enabled client-side attributes of the current VAO into the data
+ * arena and appends "count, (index, offset) * count" to W. Per-vertex arrays
+ * cover vertices [0, vertex_end), instanced ones (divisor > 0)
+ * ceil(instances / divisor) elements. */
+void stub_write_client_arrays(ArgWriter *W, GLintptr vertex_end,
+                              GLsizei instances)
+{
+  GLContextState *ctx = &g_stub_ctx[g_stub_current_ctx];
+  VAOState *vao = &ctx->vaos[ctx->current_vao];
+
+  uint32_t count_pos = W->pos;
+  uint32_t n = 0;
+  aw_u32(W, 0);
+
+  for (int i = 0; i < MAX_VERTEX_ATTRIBS; i++)
+  {
+    AttribState *a = &vao->attribs[i];
+    if (!a->enabled || a->vbo || !a->pointer)
+      continue;
+
+    GLintptr elements =
+        a->divisor ? ((GLintptr)instances + a->divisor - 1) / a->divisor
+                   : vertex_end;
+    if (elements <= 0)
+      continue;
+
+    size_t elem = gl_type_size(a->type);
+    size_t stride = a->stride ? (size_t)a->stride : (size_t)(a->size * elem);
+    size_t bytes =
+        (size_t)(elements - 1) * stride + (size_t)a->size * elem;
+
+    aw_u32(W, (uint32_t)i);
+    aw_u32(W, bridge_data_write((const void *)a->pointer, bytes));
+    n++;
+  }
+
+  memcpy(W->buf + count_pos, &n, sizeof(n));
+}
+
+/* One past the highest vertex index a draw from the bound element buffer
+ * reads: computed from a client mapping of the buffer if there is one,
+ * otherwise by the proxy. Returns -1 if it cannot be determined. */
+GLintptr stub_element_buffer_vertex_end(GLenum type, uintptr_t offset,
+                                        GLsizei count, GLint basevertex)
+{
+  GLContextState *ctx = &g_stub_ctx[g_stub_current_ctx];
+  VAOState *vao = &ctx->vaos[ctx->current_vao];
+  size_t isz = index_type_size(type);
+
+  StubMapEntry *m = find_stub_map(vao->ebo, GL_ELEMENT_ARRAY_BUFFER);
+  if (m && isz && (GLintptr)offset >= m->offset &&
+      (GLintptr)(offset + (size_t)count * isz) <= m->offset + m->length)
+  {
+    GLintptr lo = 0, hi = -1;
+    if (mapped_index_bounds((const uint8_t *)m->ptr + (offset - m->offset),
+                            count, type, basevertex, ctx->primitive_restart,
+                            &lo, &hi))
+      return hi + 1;
+  }
+
+  BRIDGE_BEGIN();
+  BridgeCtrl *C = BRIDGE_CTRL();
+  setup_scalar(OP_bridgeIndexRange);
+  ArgWriter W = aw_init(C->args, BRIDGE_ARGS_SIZE);
+  aw_u32(&W, type);
+  aw_u64(&W, (uint64_t)offset);
+  aw_i32(&W, count);
+  aw_u32(&W, ctx->primitive_restart);
+  C->args_len = W.pos;
+  int64_t max_index = (int64_t)BRIDGE_SEND_CALL();
+  if (max_index < 0)
+    return -1;
+  return (GLintptr)max_index + basevertex + 1;
+}
+
