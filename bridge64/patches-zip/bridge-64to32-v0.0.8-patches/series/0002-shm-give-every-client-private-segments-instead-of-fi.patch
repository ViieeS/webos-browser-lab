@@ -237,6 +237,13 @@ static int start_proxy(void)
 
   const char *appId = getenv("APPID") ? getenv("APPID") : "";
 
+  /* ids of the private shared-memory segments (argv[6..9] of the proxy) */
+  char ctrl_id[16], data_id[16], wl_ctrl_id[16], wl_data_id[16];
+  snprintf(ctrl_id, sizeof(ctrl_id), "%d", g_ctrl_shm.shmid);
+  snprintf(data_id, sizeof(data_id), "%d", g_data_shm.shmid);
+  snprintf(wl_ctrl_id, sizeof(wl_ctrl_id), "%d", g_ctrl_wl_shm.shmid);
+  snprintf(wl_data_id, sizeof(wl_data_id), "%d", g_data_wl_shm.shmid);
+
   /* Dummy placeholders kept so argv indices match proxy's main() */
   pid_t pid = fork();
   if (pid < 0)
@@ -248,7 +255,8 @@ static int start_proxy(void)
   if (pid == 0)
   {
     /* Child — will become the proxy process */
-    execl(bin, bin, req_str, resp_str, req_wl_str, resp_wl_str, appId, NULL);
+    execl(bin, bin, req_str, resp_str, req_wl_str, resp_wl_str, appId, ctrl_id,
+          data_id, wl_ctrl_id, wl_data_id, NULL);
     log_console("execl(%s) FAILED: %s", bin, strerror(errno));
     _exit(1);
   }
@@ -277,9 +285,13 @@ static void bridge_init(void)
     log_console("%d -> %s", i, opcode_to_string(i));
   }*/
 
-  g_ctrl_shm = shm_create(GLES_BRIDGE_CTRL_SHM, bridge_ctrl_shm_size());
+  /* Private segments: every client gets its own, and the proxy attaches by
+   * id. With the fixed keys 0x4701-0x4704 a second bridge client (another
+   * app, or a second process of the same app) removed the first client's
+   * segments, and a proxy could attach to the wrong client's ring. */
+  g_ctrl_shm = shm_create_private(bridge_ctrl_shm_size());
 
-  g_data_shm = shm_create(GLES_BRIDGE_DATA_SHM, GLES_BRIDGE_DATA_SIZE);
+  g_data_shm = shm_create_private(GLES_BRIDGE_DATA_SIZE);
 
   g_ring = (BridgeRing *)g_ctrl_shm.ptr;
   g_data = (uint8_t *)g_data_shm.ptr;
@@ -552,9 +564,9 @@ void wl_bridge_init(void)
 {
   log_console("initialising wl bridge");
 
-  g_ctrl_wl_shm = shm_create(GLES_BRIDGE_WL_CTRL_SHM, bridge_ctrl_shm_size());
+  g_ctrl_wl_shm = shm_create_private(bridge_ctrl_shm_size());
 
-  g_data_wl_shm = shm_create(GLES_BRIDGE_WL_DATA_SHM, GLES_BRIDGE_DATA_SIZE);
+  g_data_wl_shm = shm_create_private(GLES_BRIDGE_DATA_SIZE);
 
   g_wl.ctrl = (BridgeCtrl *)g_ctrl_wl_shm.ptr;
 
