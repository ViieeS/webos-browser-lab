+/* ── EGL fences (EGL_KHR_fence_sync, EGL_KHR_wait_sync) ─────────────────────
+ * The display goes over as its bridge index and the attribute list is copied;
+ * the sync handle is the proxy's 32-bit EGLSyncKHR, kept opaque here. */
+static EGLSyncKHR EGLAPIENTRY bridge_eglCreateSyncKHR(EGLDisplay dpy,
+                                                      EGLenum type,
+                                                      const EGLint *attrib_list)
+{
+  BRIDGE_BEGIN();
+  BridgeCtrl *C = BRIDGE_CTRL();
+  setup_egl(OP_eglCreateSyncKHR);
+  ArgWriter W = aw_init(C->args, BRIDGE_ARGS_SIZE);
+  aw_u32(&W, H2I(dpy));
+  aw_u32(&W, type);
+  uint32_t n = 0;
+  if (attrib_list)
+    while (attrib_list[n] != EGL_NONE && n < 32)
+      n += 2;
+  aw_u32(&W, n);
+  for (uint32_t i = 0; i < n; i++)
+    aw_i32(&W, attrib_list[i]);
+  C->args_len = W.pos;
+  return (EGLSyncKHR)(uintptr_t)BRIDGE_SEND_CALL();
+}
+
+static EGLBoolean EGLAPIENTRY bridge_eglDestroySyncKHR(EGLDisplay dpy,
+                                                       EGLSyncKHR sync)
+{
+  BRIDGE_BEGIN();
+  BridgeCtrl *C = BRIDGE_CTRL();
+  setup_egl(OP_eglDestroySyncKHR);
+  ArgWriter W = aw_init(C->args, BRIDGE_ARGS_SIZE);
+  aw_u32(&W, H2I(dpy));
+  aw_u64(&W, (uint64_t)(uintptr_t)sync);
+  C->args_len = W.pos;
+  return (EGLBoolean)BRIDGE_SEND_CALL();
+}
+
+static EGLint EGLAPIENTRY bridge_eglClientWaitSyncKHR(EGLDisplay dpy,
+                                                      EGLSyncKHR sync,
+                                                      EGLint flags,
+                                                      EGLTimeKHR timeout)
+{
+  BRIDGE_BEGIN();
+  BridgeCtrl *C = BRIDGE_CTRL();
+  setup_egl(OP_eglClientWaitSyncKHR);
+  ArgWriter W = aw_init(C->args, BRIDGE_ARGS_SIZE);
+  aw_u32(&W, H2I(dpy));
+  aw_u64(&W, (uint64_t)(uintptr_t)sync);
+  aw_i32(&W, flags);
+  aw_u64(&W, timeout);
+  C->args_len = W.pos;
+  return (EGLint)BRIDGE_SEND_CALL();
+}
+
+static EGLint EGLAPIENTRY bridge_eglWaitSyncKHR(EGLDisplay dpy, EGLSyncKHR sync,
+                                                EGLint flags)
+{
+  BRIDGE_BEGIN();
+  BridgeCtrl *C = BRIDGE_CTRL();
+  setup_egl(OP_eglWaitSyncKHR);
+  ArgWriter W = aw_init(C->args, BRIDGE_ARGS_SIZE);
+  aw_u32(&W, H2I(dpy));
+  aw_u64(&W, (uint64_t)(uintptr_t)sync);
+  aw_i32(&W, flags);
+  C->args_len = W.pos;
+  return (EGLint)BRIDGE_SEND_CALL();
+}
+
+static EGLBoolean EGLAPIENTRY bridge_eglGetSyncAttribKHR(EGLDisplay dpy,
+                                                         EGLSyncKHR sync,
+                                                         EGLint attribute,
+                                                         EGLint *value)
+{
+  BRIDGE_BEGIN();
+  BridgeCtrl *C = BRIDGE_CTRL();
+  setup_egl(OP_eglGetSyncAttribKHR);
+  ArgWriter W = aw_init(C->args, BRIDGE_ARGS_SIZE);
+  aw_u32(&W, H2I(dpy));
+  aw_u64(&W, (uint64_t)(uintptr_t)sync);
+  aw_i32(&W, attribute);
+  C->args_len = W.pos;
+  uint64_t r = BRIDGE_SEND_CALL();
+  if (value)
+    *value = (EGLint)(uint32_t)r;
+  return (EGLBoolean)(r >> 32);
+}
+
+static void *bridge_sync_proc(const char *name)
+{
+  if (!strcmp(name, "eglCreateSyncKHR"))
+    return (void *)bridge_eglCreateSyncKHR;
+  if (!strcmp(name, "eglDestroySyncKHR"))
+    return (void *)bridge_eglDestroySyncKHR;
+  if (!strcmp(name, "eglClientWaitSyncKHR"))
+    return (void *)bridge_eglClientWaitSyncKHR;
+  if (!strcmp(name, "eglWaitSyncKHR"))
+    return (void *)bridge_eglWaitSyncKHR;
+  if (!strcmp(name, "eglGetSyncAttribKHR"))
+    return (void *)bridge_eglGetSyncAttribKHR;
+  return NULL;
+}
+
 EGLAPI __eglMustCastToProperFunctionPointerType EGLAPIENTRY
 eglGetProcAddress(const char *procname)
 {
@@ -1478,6 +1580,13 @@ eglGetProcAddress(const char *procname)
   if (!strcmp(procname, "eglCreatePlatformWindowSurfaceEXT"))
     return (void *)eglCreatePlatformWindowSurfaceEXT;
 
+  /* EGL fences: forwarded with display translation (not the generic path) */
+  {
+    void *sync = bridge_sync_proc(procname);
+    if (sync)
+      return sync;
+  }
+
   /* 1. GLES table */
   ProcEntry *p = find_proc(procname);
 
