diff --git a/proxy/protocol/egl.c b/proxy/protocol/egl.c
index b1fa772..6ba435b 100644
--- a/proxy/protocol/egl.c
+++ b/proxy/protocol/egl.c
@@ -1246,3 +1246,99 @@ void h_eglDestroyImageKHR(BridgeCtrl *C, uint8_t *D)
 
   C->result = ok ? 1 : 0;
 }
+
+/* ── EGL fences (EGL_KHR_fence_sync, EGL_KHR_wait_sync) ─────────────────────
+ *
+ * These used to go through the generic dynamic dispatch, which passed the
+ * stub's display index as the EGLDisplay and the 64-bit attribute-list pointer
+ * through unchanged, so fence creation failed (or read garbage) and WebKit's
+ * cross-context synchronisation (painting threads to compositor) silently did
+ * nothing: tiles were sampled before the GPU had finished painting them.
+ *
+ * Waiting: this proxy serves every client thread from one thread, so a blocking
+ * client wait stalls all contexts until the fence signals. That is safe as long
+ * as the fence's commands have been submitted: the fence is flushed right after
+ * it is created, and the client wait also asks for a flush. The GPU then always
+ * makes progress, and the wait ends without help from another context. A
+ * server wait (eglWaitSyncKHR) never blocks the proxy. */
+
+typedef EGLSyncKHR (*PFN_CreateSync)(EGLDisplay, EGLenum, const EGLint *);
+typedef EGLBoolean (*PFN_DestroySync)(EGLDisplay, EGLSyncKHR);
+typedef EGLint (*PFN_ClientWaitSync)(EGLDisplay, EGLSyncKHR, EGLint, EGLTimeKHR);
+typedef EGLint (*PFN_WaitSync)(EGLDisplay, EGLSyncKHR, EGLint);
+typedef EGLBoolean (*PFN_GetSyncAttrib)(EGLDisplay, EGLSyncKHR, EGLint, EGLint *);
+
+#define SYNC_PROC(type, var, name)                                             \
+  static type var;                                                             \
+  if (!var)                                                                    \
+    var = (type)eglGetProcAddress(name);
+
+void h_eglCreateSyncKHR(BridgeCtrl *C, uint8_t *D)
+{
+  (void)D;
+  AR(r);
+  uint32_t di = ar_u32(&r);
+  EGLenum type = ar_u32(&r);
+  uint32_t n = ar_u32(&r);
+  EGLint attribs[34];
+  uint32_t i = 0;
+  for (; i < n && i < 32; i++)
+    attribs[i] = ar_i32(&r);
+  attribs[i] = EGL_NONE;
+
+  SYNC_PROC(PFN_CreateSync, create, "eglCreateSyncKHR");
+  EGLSyncKHR s = create ? create(DISP(di), type, attribs) : EGL_NO_SYNC_KHR;
+  if (s != EGL_NO_SYNC_KHR)
+    glFlush(); /* submit the fence so a wait from any context can finish */
+  else
+    log_error("eglCreateSyncKHR(0x%x) failed: 0x%x", type, eglGetError());
+  C->result = (uint64_t)(uintptr_t)s;
+}
+
+void h_eglDestroySyncKHR(BridgeCtrl *C, uint8_t *D)
+{
+  (void)D;
+  AR(r);
+  uint32_t di = ar_u32(&r);
+  EGLSyncKHR s = (EGLSyncKHR)(uintptr_t)ar_u64(&r);
+  SYNC_PROC(PFN_DestroySync, destroy, "eglDestroySyncKHR");
+  C->result = destroy ? destroy(DISP(di), s) : EGL_FALSE;
+}
+
+void h_eglClientWaitSyncKHR(BridgeCtrl *C, uint8_t *D)
+{
+  (void)D;
+  AR(r);
+  uint32_t di = ar_u32(&r);
+  EGLSyncKHR s = (EGLSyncKHR)(uintptr_t)ar_u64(&r);
+  EGLint flags = ar_i32(&r);
+  EGLTimeKHR timeout = ar_u64(&r);
+  SYNC_PROC(PFN_ClientWaitSync, cwait, "eglClientWaitSyncKHR");
+  C->result = (uint64_t)(int64_t)(
+      cwait ? cwait(DISP(di), s, flags | EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, timeout)
+            : EGL_FALSE);
+}
+
+void h_eglWaitSyncKHR(BridgeCtrl *C, uint8_t *D)
+{
+  (void)D;
+  AR(r);
+  uint32_t di = ar_u32(&r);
+  EGLSyncKHR s = (EGLSyncKHR)(uintptr_t)ar_u64(&r);
+  EGLint flags = ar_i32(&r);
+  SYNC_PROC(PFN_WaitSync, swait, "eglWaitSyncKHR");
+  C->result = (uint64_t)(int64_t)(swait ? swait(DISP(di), s, flags) : EGL_FALSE);
+}
+
+void h_eglGetSyncAttribKHR(BridgeCtrl *C, uint8_t *D)
+{
+  (void)D;
+  AR(r);
+  uint32_t di = ar_u32(&r);
+  EGLSyncKHR s = (EGLSyncKHR)(uintptr_t)ar_u64(&r);
+  EGLint attr = ar_i32(&r);
+  EGLint value = 0;
+  SYNC_PROC(PFN_GetSyncAttrib, getattr, "eglGetSyncAttribKHR");
+  EGLBoolean ok = getattr ? getattr(DISP(di), s, attr, &value) : EGL_FALSE;
+  C->result = ((uint64_t)(uint32_t)value) | ((uint64_t)ok << 32);
+}
