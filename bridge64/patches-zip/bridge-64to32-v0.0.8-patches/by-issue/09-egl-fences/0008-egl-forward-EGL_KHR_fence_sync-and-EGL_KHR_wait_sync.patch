diff --git a/stub/egl_stub.c b/stub/egl_stub.c
index 080dc5d..bc4657a 100644
--- a/stub/egl_stub.c
+++ b/stub/egl_stub.c
@@ -1456,6 +1456,108 @@ void *lookup_core_func(const char *procname)
