HEVC Main and Main 10 are supported types when LG's decoder is reachable through NDL.

The NDL renderer (upstream patch 0023, content/renderer/media/cn_ndl_renderer.cc) already plays HEVC: it maps
VideoCodec::kHEVC to NDL's codec 2 and gets Annex B from the demuxer. The type check rejected HEVC first:
IsDecoderHevcProfileSupported() asks the supplemental profile cache, which the GPU process fills from its hardware
decoders (VAAPI on Linux). The TV has none, so canPlayType() and MediaSource.isTypeSupported() said no and a src
<video> failed with NotSupportedError. On webOS the check now follows the renderer factory's own condition: the
launcher exported $CN_MEDIA_SOCK. Main and Main 10 only: the profiles LG's decoder plays (HEVCP1_HEVC resource,
4K 10-bit checked through NDL on the LG C1).

diff -ru a/src/media/base/supported_types.cc b/src/media/base/supported_types.cc
--- a/src/media/base/supported_types.cc	2026-11-18 21:00:00
+++ b/src/media/base/supported_types.cc	2026-11-18 21:00:00
@@ -4,6 +4,8 @@

 #include "media/base/supported_types.h"

+#include <stdlib.h>
+
 #include "base/command_line.h"
 #include "base/feature_list.h"
 #include "base/logging.h"
@@ -233,6 +235,16 @@
     return false;
   }

+#if defined(OS_WEBOS)
+  // LG's decoder plays HEVC through the NDL renderer, which is in use when the
+  // launcher exported $CN_MEDIA_SOCK (CnNdlRendererFactory::Enabled). There is
+  // no VAAPI, so the profile cache below never lists HEVC.
+  if (const char* sock = getenv("CN_MEDIA_SOCK"); sock && *sock) {
+    return type.profile == HEVCPROFILE_MAIN ||
+           type.profile == HEVCPROFILE_MAIN10;
+  }
+#endif  // defined(OS_WEBOS)
+
 #if BUILDFLAG(ENABLE_PLATFORM_HEVC)
 #if BUILDFLAG(PLATFORM_HAS_OPTIONAL_HEVC_DECODE_SUPPORT)
 #if BUILDFLAG(IS_CHROMEOS)
