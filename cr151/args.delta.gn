# Our changes on top of WebOS-Chromium source/args.gn (tag v0.0.66). Everything else stays theirs.
# Applied by appending to their args.gn: GN takes the last assignment of a variable.

# Speed instead of size: full ThinLTO with cross-module optimisation, -O2 instead of -Os.
optimize_for_size = false
thin_lto_enable_optimizations = true
# Instrumented PGO from Google's Android arm32 profile pinned on this tag (chrome/build/android-arm32.pgo.txt):
# no arm32 Linux profile exists, and Android arm32 shares the 32-bit V8 and most of Blink and Skia. Functions whose
# code differs on Linux get no profile, which clang skips silently. Downloaded into the build volume
# (docs/SOURCES.md). Speedometer +11 % against ChromeOS's ARM AFDO profile (cr151/pgo_ab.txt), which itself measured
# within noise (cr151/afdo_ab.txt).
chrome_pgo_phase = 2
pgo_data_path = "/work/pgo/android32.profdata"

# The C1's Cortex-A55 runs this 32-bit code in AArch32. ARMv8.2-A has SDIV/UDIV in ARM and Thumb
# (plain armv7-a does not, so every division was a libgcc call). arm_tune and arm_fpu are not GN args
# in M151: patch 0101 adds -mtune=cortex-a55 and -mfpu=neon-fp-armv8 for arm_version 8.
arm_version = 8
arm_arch = "armv8.2-a"
