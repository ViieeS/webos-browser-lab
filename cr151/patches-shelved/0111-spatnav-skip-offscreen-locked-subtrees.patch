   FocusCandidate best_candidate, previous_best_candidate;
   double previous_best_distance = kMaxDistance;
   double best_distance = kMaxDistance;
-  for (; element;
-       element =
-           IsScrollableAreaOrDocument(element, direction)
+  Element* next = nullptr;
+  for (; element; element = next) {
+    // An offscreen locked display lock (content-visibility: auto away from the
+    // viewport, or hidden) leaves nothing in its subtree that could win:
+    // ConsiderForBestCandidate drops offscreen candidates. On a long article
