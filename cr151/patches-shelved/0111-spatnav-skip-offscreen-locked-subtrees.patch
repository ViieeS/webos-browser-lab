+    }
+    next = IsScrollableAreaOrDocument(element, direction)
                ? ElementTraversal::NextSkippingChildren(*element, &container)
-               : ElementTraversal::Next(*element, &container)) {
+               : ElementTraversal::Next(*element, &container);
+
     if (element == interest_child_in_container)
       continue;
 
@@ -474,7 +486,7 @@
   }
   TRACE_EVENT_INSTANT("blink", "SpatialNavigation::CandidateWalk", "elements",
                       elements, "forced_updates", forced, "stayed_clean",
-                      skip_updates);
+                      skip_updates, "skipped_subtrees", skipped_subtrees);
 
   return best_candidate;
