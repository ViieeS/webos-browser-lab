# aarch64 userspace for the C1 (4x Cortex-A55, kernel 4.4), expanded by `make olddefconfig`.
BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
# glibc's minimum kernel follows the headers; the TV kernel is 4.4.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.4.302"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_4=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_ROOTFS_TAR is not set

BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_WPEBACKEND_FDO=y
# Same media stack as the 32-bit build; 2.52.6 also fails to compile with video off.
BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_LIBAV=y
BR2_PACKAGE_GLIB_NETWORKING=y
BR2_PACKAGE_CA_CERTIFICATES=y

BR2_JLEVEL=6
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/ccache"
BR2_DL_DIR="/work/dl"
BR2_GLOBAL_PATCH_DIR="/src/patches"
