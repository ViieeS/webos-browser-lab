 #include "BPlatform.h"
 #include "VMAllocate.h"
+#include <algorithm>
+#include <cstdint>
 #include <cstdlib>
+#include <cstring>
+#include <malloc.h>
 #include <thread>
 
 #if BENABLE(LIBPAS)
@@ -165,30 +169,91 @@
