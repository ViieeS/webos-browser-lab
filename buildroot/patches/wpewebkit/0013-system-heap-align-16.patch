 }
 
+// glibc malloc aligns to 8 on 32-bit ARM, but WebKit has alignas(16) types that fastMalloc places
+// without regard to their alignment, and GCC stores into them with aligned NEON ("vst1 [rN :128]"),
+// which faults on an 8-aligned object. glibc's aligned_alloc is a slow path (Speedometer -15%), so
+// every block is a plain malloc with slack: the returned pointer is rounded up to the alignment and
+// the word just below it holds the distance back to glibc's pointer.
+static constexpr size_t systemHeapAlignment = 16;
+
+static size_t slackFor(size_t alignment)
+{
+    return alignment + sizeof(uint32_t);
+}
+
+static void* alignInBlock(void* base, size_t alignment)
+{
+    uintptr_t raw = reinterpret_cast<uintptr_t>(base);
+    uintptr_t aligned = (raw + sizeof(uint32_t) + alignment - 1) & ~(alignment - 1);
+    reinterpret_cast<uint32_t*>(aligned)[-1] = static_cast<uint32_t>(aligned - raw);
+    return reinterpret_cast<void*>(aligned);
+}
+
+static void* baseOfBlock(void* object)
+{
+    return static_cast<char*>(object) - static_cast<uint32_t*>(object)[-1];
+}
+
+static void* allocateAligned(size_t alignment, size_t size)
+{
+    alignment = alignment < systemHeapAlignment ? systemHeapAlignment : alignment;
+    if (size > SIZE_MAX - slackFor(alignment))
+        return nullptr;
+    void* base = ::malloc(size + slackFor(alignment));
+    return base ? alignInBlock(base, alignment) : nullptr;
+}
+
 void* SystemHeap::malloc(size_t size, FailureAction action)
 {
-    void* result = ::malloc(size);
+    void* result = allocateAligned(systemHeapAlignment, size);
     RELEASE_BASSERT(action == FailureAction::ReturnNull || result);
     return result;
 }
 
 void* SystemHeap::memalign(size_t alignment, size_t size, FailureAction action)
 {
-    void* result = ::aligned_alloc(alignment, size);
+    void* result = allocateAligned(alignment, size);
     RELEASE_BASSERT(action == FailureAction::ReturnNull || result);
     return result;
 }
 
+// Grows in place when glibc can. The data keeps its offset inside glibc's block, so it is moved when
+// the new block needs a different one; a block from memalign comes back 16-aligned only.
 void* SystemHeap::realloc(void* object, size_t size, FailureAction action)
 {
-    void* result = ::realloc(object, size);
+    if (!object)
+        return malloc(size, action);
+    size_t slack = slackFor(systemHeapAlignment);
+    void* result = nullptr;
+    void* oldBase = baseOfBlock(object);
+    size_t oldOffset = static_cast<char*>(object) - static_cast<char*>(oldBase);
+    if (oldOffset > slack) {
+        // From memalign with a larger alignment: the data sits further in than a 16-aligned block allows.
+        result = allocateAligned(systemHeapAlignment, size);
+        if (result) {
+            memcpy(result, object, std::min(size, malloc_usable_size(oldBase) - oldOffset));
+            ::free(oldBase);
+        }
+    } else if (size <= SIZE_MAX - slack) {
+        void* base = ::realloc(oldBase, size + slack);
+        if (base) {
+            void* data = static_cast<char*>(base) + oldOffset;
+            uintptr_t raw = reinterpret_cast<uintptr_t>(base);
+            uintptr_t aligned = (raw + sizeof(uint32_t) + systemHeapAlignment - 1) & ~(systemHeapAlignment - 1);
+            size_t keep = std::min(size, raw + size + slack - reinterpret_cast<uintptr_t>(data));
+            if (reinterpret_cast<void*>(aligned) != data)
+                memmove(reinterpret_cast<void*>(aligned), data, keep);
+            result = alignInBlock(base, systemHeapAlignment);
+        }
+    }
     RELEASE_BASSERT(action == FailureAction::ReturnNull || result);
     return result;
 }
 
 void SystemHeap::free(void* object)
 {
-    ::free(object);
+    if (object)
+        ::free(baseOfBlock(object));
 }
 
