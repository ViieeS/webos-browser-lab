WasmOrigin needs Wasm::OpcodeOrigin, which only exists with ENABLE(WEBASSEMBLY). A JIT build
with WebAssembly off (our softfp ARMv7 build) fails to compile without this guard.

--- a/Source/JavaScriptCore/jit/PCToCodeOriginMap.h
+++ b/Source/JavaScriptCore/jit/PCToCodeOriginMap.h
@@ -43,6 +43,7 @@
 class PCToOriginMap;
 }
 
+#if ENABLE(WEBASSEMBLY)
 namespace Wasm {
 class WasmOrigin {
     MAKE_VALIDATED_REINTERPRET_CAST
@@ -61,6 +62,7 @@
 MAKE_VALIDATED_REINTERPRET_CAST_IMPL("WasmOrigin", WasmOrigin)
 
 } // namespace Wasm
+#endif
 
 class LinkBuffer;
 class PCToCodeOriginMapBuilder;
